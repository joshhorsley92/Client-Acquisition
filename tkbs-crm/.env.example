# TKBS CRM — environment variable template
# Copy this file to .env and fill in real values. .env is gitignored.

# Server
PORT=3001
NODE_ENV=development
SESSION_SECRET=change-me-in-production-use-a-long-random-string

# Database (defaults to ./tkbs-crm.db if unset)
# DB_PATH=

# Anthropic — required for Brand Profile extraction from call transcripts
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Whisper auto-transcription (LOCAL, free) — runs the open-source Whisper
# model via `python -m whisper`. Prereqs: Python 3, ffmpeg, and
# `pip install openai-whisper`. No API key needed.
#
# Optional overrides:
#   WHISPER_MODEL — tiny.en (default, fastest), base.en, small.en, medium.en
#   WHISPER_PYTHON — path to a Python executable if `python` isn't on PATH
# WHISPER_MODEL=tiny.en
# WHISPER_PYTHON=python

# Lead-acquisition pipeline (Find New Clients button)
# Same Python interpreter as Whisper; falls back to WHISPER_PYTHON if unset.
#
# IMPORTANT on Windows: the bare `python` command often resolves to the
# Microsoft Store stub at C:\Users\<you>\AppData\Local\Microsoft\WindowsApps
# \python.exe. When child_process.spawn() invokes that stub it can hang
# silently with no output and no exit event. Set TKBS_PYTHON to the
# explicit path of your real interpreter, e.g.:
#   TKBS_PYTHON=C:\Users\<you>\AppData\Local\Python\pythoncore-3.14-64\python.exe
# Find your real path with:  python -c "import sys; print(sys.executable)"
# TKBS_PYTHON=python

# Gmail integration (optional; for email tracking via OAuth)
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REDIRECT_URI=http://localhost:3001/api/integrations/google/callback

# Slack integration (optional; bot token for deal notifications)
# SLACK_BOT_TOKEN=

# Twilio integration (optional; for SMS from deal views)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
