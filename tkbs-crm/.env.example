# TKBS CRM — environment variable template
# Copy this file to .env and fill in real values. .env is gitignored.

# Server
PORT=3001
NODE_ENV=development
SESSION_SECRET=change-me-in-production-use-a-long-random-string

# Database (defaults to ./tkbs-crm.db if unset)
# DB_PATH=

# Anthropic — required for Brand Profile extraction from call transcripts
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# TKBS Dashboard integration — required to push Brand Profile to Dashboard
# (deferred; not needed until Initiative 1 Stage 4 ships)
# DASHBOARD_API_URL=https://dashboard.turnkeymarketing.com
# DASHBOARD_SERVICE_ROLE_KEY=

# Gmail integration (optional; for email tracking via OAuth)
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REDIRECT_URI=http://localhost:3001/api/integrations/google/callback

# Slack integration (optional; bot token for deal notifications)
# SLACK_BOT_TOKEN=

# Twilio integration (optional; for SMS from deal views)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
