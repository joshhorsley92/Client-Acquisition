# TKBS CRM v1.0 — environment variables
# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Supabase — same project as the Dashboard, but isolated to the `crm` schema.
# Find these in your Supabase dashboard under Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Optional: Postgres pooler URL for serverless connection management.
# Falls back to NEXT_PUBLIC_SUPABASE_URL if unset.
# SUPABASE_POOLER_URL=

# Anthropic — for Brand Profile extraction from call transcripts + Automations
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: lifts the URL the app advertises in emails / OAuth callbacks.
# Defaults to http://localhost:3000 in dev.
# NEXT_PUBLIC_APP_URL=https://crm.tkbsmarketing.com
