{
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npx jest)",
      "Bash(npx jest --silent)",
      "Bash(tasklist)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"c:/Client-Acquisition/.claude/hooks/notify-slack.sh\"",
            "async": true,
            "statusMessage": "Notifying Josh on Slack..."
          }
        ]
      }
    ]
  }
}
